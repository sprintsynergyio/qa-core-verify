{
  "name": "qa-core-verify",
  "version": "0.0.1",
  "description": "Audit a Playwright suite for weak assertions and write console, JSON, Markdown, and HTML reports. Work in progress, private until v0.1 review.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qa-core-verify": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm run build && node dist/cli.js",
    "demo:saucedemo": "playwright test -c example-project/saucedemo"
  },
  "dependencies": {
    "@playwright/test": "1.60.0",
    "playwright": "1.60.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1"
  }
}
