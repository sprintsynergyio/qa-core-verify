{
  "name": "qa-core-verify",
  "version": "0.1.0",
  "description": "Audits a Playwright suite and reports whether each test can be trusted to go red when the feature breaks.",
  "keywords": [
    "playwright",
    "playwright-test",
    "test-automation",
    "testing",
    "mutation-testing",
    "qa",
    "e2e"
  ],
  "homepage": "https://github.com/sprintsynergyio/qa-core-verify#readme",
  "bugs": {
    "url": "https://github.com/sprintsynergyio/qa-core-verify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprintsynergyio/qa-core-verify.git"
  },
  "author": {
    "name": "SprintSynergy",
    "url": "https://sprintsynergy.com"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qa-core-verify": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm run build && node dist/cli.js",
    "demo:saucedemo": "playwright test -c example-project/saucedemo"
  },
  "dependencies": {
    "@playwright/test": "1.60.0",
    "playwright": "1.60.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1"
  }
}
