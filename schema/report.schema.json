{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-core-verify/report.schema.json",
  "title": "qa-core-verify Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "startedAt", "finishedAt", "project", "checksRun", "summary", "tests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": { "$ref": "#/$defs/tool" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "finishedAt": { "$ref": "#/$defs/timestamp" },
    "project": { "$ref": "#/$defs/project" },
    "checksRun": {
      "type": "array",
      "items": { "enum": ["weak-assertion", "locator", "cannot-fail"] }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "qa-core-verify" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}[+-][0-9]{2}:[0-9]{2}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "configFile", "specCount", "testCount"],
      "properties": {
        "dir": { "type": "string" },
        "configFile": { "type": ["string", "null"] },
        "specCount": { "type": "integer", "minimum": 0 },
        "testCount": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "verdict"],
      "properties": {
        "severity": { "$ref": "#/$defs/severityCounts" },
        "verdict": { "$ref": "#/$defs/verdictCounts" }
      }
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warn", "info"],
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "verdictCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted", "review", "untrusted", "baseline-red", "not-run"],
      "properties": {
        "trusted": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 },
        "untrusted": { "type": "integer", "minimum": 0 },
        "baseline-red": { "type": "integer", "minimum": 0 },
        "not-run": { "type": "integer", "minimum": 0 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "line", "titlePath", "verdict", "findings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "titlePath": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "verdict": { "enum": ["trusted", "review", "untrusted", "baseline-red", "not-run"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "locators": {
          "type": "array",
          "items": { "$ref": "#/$defs/locator" }
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "api", "status", "file", "line", "column", "counts", "parentCounts"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "api": { "type": "string" },
        "status": { "enum": ["unique", "ambiguous", "never-matched"] },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "counts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "parentCounts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "check", "severity", "file", "line", "column", "message", "evidence", "fixHint"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "check": { "enum": ["weak-assertion", "locator", "cannot-fail"] },
        "severity": { "enum": ["error", "warn", "info"] },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "message": { "type": "string" },
        "evidence": { "type": "string" },
        "fixHint": { "type": "string" },
        "relatedLintRule": { "type": "string", "minLength": 1 }
      }
    }
  }
}
